# Base de datos PostgreSQL (local para desarrollo; en producción usar Google Cloud SQL para PostgreSQL)
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/gesticole?schema=public"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genere-un-valor-con: openssl rand -base64 32"

# Credenciales de OAuth de Google (Google Cloud Console > APIs y Servicios > Credenciales)
# Deje estos valores vacíos para usar la app en modo demostración (sin Google).
# Habilite: Google Drive API, Gmail API, Google Classroom API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
